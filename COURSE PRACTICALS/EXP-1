import heapq

GOAL_STATE = (1, 2, 3, 4, 5, 6, 7, 8, 0)

class PuzzleNode:
    def __init__(self, state, parent=None, move="", g=0):
        self.state = state
        self.parent = parent
        self.move = move
        self.g = g
        self.h = self.calculate_heuristic()
        self.f = self.g + self.h

    def calculate_heuristic(self):
        distance = 0
        for index, value in enumerate(self.state):
            if value != 0:
                target_x, target_y = (value - 1) // 3, (value - 1) % 3
                current_x, current_y = index // 3, index % 3
                distance += abs(target_x - current_x) + abs(target_y - current_y)
        return distance

    def __lt__(self, other):
        return self.f < other.f

def get_neighbors(node):
    neighbors = []
    zero_idx = node.state.index(0)
    row, col = zero_idx // 3, zero_idx % 3
    moves = {'UP': (-1, 0), 'DOWN': (1, 0), 'LEFT': (0, -1), 'RIGHT': (0, 1)}

    for move_name, (dr, dc) in moves.items():
        new_row, new_col = row + dr, col + dc
        if 0 <= new_row < 3 and 0 <= new_col < 3:
            new_zero_idx = new_row * 3 + new_col
            state_list = list(node.state)
            state_list[zero_idx], state_list[new_zero_idx] = state_list[new_zero_idx], state_list[zero_idx]
            neighbors.append(PuzzleNode(tuple(state_list), node, move_name, node.g + 1))
            
    return neighbors

def solve_8_puzzle(initial_state):
    start_node = PuzzleNode(initial_state)
    open_list = []
    heapq.heappush(open_list, start_node)
    visited = set()

    while open_list:
        current_node = heapq.heappop(open_list)

        if current_node.state == GOAL_STATE:
            path = []
            curr = current_node
            while curr.parent:
                path.append((curr.move, curr.state))
                curr = curr.parent
            path.reverse()
            return path

        visited.add(current_node.state)

        for neighbor in get_neighbors(current_node):
            if neighbor.state not in visited:
                heapq.heappush(open_list, neighbor)

    return None

def print_board(state):
    for i in range(0, 9, 3):
        print(state[i:i+3])
    print()

if __name__ == "__main__":
    initial_board = (1, 2, 3, 4, 0, 6, 7, 5, 8)
    print("Initial State:")
    print_board(initial_board)
    
    solution = solve_8_puzzle(initial_board)
    if solution:
        print(f"Solved in {len(solution)} moves:\n")
        for step, (move, state) in enumerate(solution, 1):
            print(f"Step {step}: Move {move}")
            print_board(state)
